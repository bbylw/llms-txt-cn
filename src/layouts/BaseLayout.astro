---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
// Preload primary sans font so text paints without flash.
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import "../styles/globals.css";
import "../styles/prose.css";
import { ClientRouter } from "astro:transitions";
import { config } from "virtual:nimbus/config";
import {
  getPublishedLlmsUrl,
  getPageLanguage,
  getVersionStatus,
  withBase,
} from "@cloudflare/nimbus-docs/runtime";
import AgentDirective from "@/components/AgentDirective.astro";
import { SearchDialog } from "@/components/ui/search";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import WebMCP from "@/components/WebMCP.astro";
import type { BasePageProps } from "@cloudflare/nimbus-docs/types";

type Props = BasePageProps;

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  socialImageSize,
  socialImageAlt,
  locale,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  apiVersion,
  coordinate,
} = Astro.props;

const { lang, dir } = await getPageLanguage(locale);
const versionStatusKey =
  apiVersion && collection ? `${collection}@${apiVersion}` : collection;
const versionStatus = versionStatusKey
  ? await getVersionStatus(versionStatusKey)
  : null;
const isHiddenVersion = versionStatus?.isHidden === true;
const llmsIndexPath = await getPublishedLlmsUrl(collection ?? undefined);
const baseUrl = import.meta.env.BASE_URL;
const basedLlmsUrl = llmsIndexPath ? withBase(llmsIndexPath, baseUrl) : null;
const llmsUrl = basedLlmsUrl
  ? Astro.site
    ? new URL(basedLlmsUrl, Astro.site).href
    : basedLlmsUrl
  : null;
const basedMarkdownUrl = markdownUrl ? withBase(markdownUrl, baseUrl) : undefined;
const resolvedMarkdownUrl =
  basedMarkdownUrl && Astro.site
    ? new URL(basedMarkdownUrl, Astro.site).href
    : basedMarkdownUrl;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const KEY = "color-scheme";
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        let unsaved = null;

        const readStored = () => {
          if (unsaved) return unsaved;
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" ? v : null;
          } catch {
            return null;
          }
        };

        const applyTheme = () => {
          const stored = readStored();
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.setAttribute("content", stored ?? "light dark");
          const mode = stored ?? (media.matches ? "dark" : "light");
          const root = document.documentElement;
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((btn) => {
            btn.setAttribute("data-nb-state", mode);
            btn.setAttribute("aria-pressed", String(mode === "dark"));
          });
        };

        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          // Only update rendered state when following system; never delete stored override.
          if (!readStored()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        window.__nbApplyTheme = (mode) => {
          if (mode === "dark" || mode === "light") unsaved = mode;
          else if (mode === null) unsaved = null;
          applyTheme();
        };
      })();
    </script>
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {!isHiddenVersion && llmsUrl && <link rel="describedby" href={llmsUrl} />}
    <WebMCP />

    <NimbusHead
      title={title}
      description={description}
      noindex={noindex}
      markdownUrl={markdownUrl}
      socialImage={socialImage}
      socialImageSize={socialImageSize}
      socialImageAlt={socialImageAlt}
      locale={locale}
      lastUpdated={lastUpdated}
      head={pageHead}
      collection={collection}
      entryId={entryId}
      apiVersion={apiVersion}
      coordinate={coordinate}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:start-2 focus:top-2 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground focus:no-underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
    >
      跳至正文内容
    </a>
    {!isHiddenVersion && (
      <AgentDirective markdownUrl={resolvedMarkdownUrl ?? null} llmsUrl={llmsUrl} />
    )}
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { codeCopy, headingAnchors } from "@cloudflare/nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>
  </body>
</html>
