---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingNav from "@/components/landing/LandingNav.astro";
import LandingFooter from "@/components/landing/LandingFooter.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;
const homeHref = withBase("/", import.meta.env.BASE_URL);
const docsHref = withBase("/docs/", import.meta.env.BASE_URL);
---

<BaseLayout title="使用条款" description="llms.txt 中文站的内容来源、开源许可与免责声明。">
  <div class="flex min-h-screen flex-col bg-background text-foreground">
    <LandingNav />
    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-3xl flex-1 px-4 py-16 sm:px-6 sm:py-24">
      <h1 class="text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
        使用条款
      </h1>
      <p class="mt-4 text-sm text-muted-foreground">最近更新：2026 年 11 月 23 日</p>

      <div class="mt-8 space-y-6 text-base leading-7 text-muted-foreground [text-wrap:pretty]">
        <section class="space-y-2">
          <h2 class="text-xl font-semibold text-foreground">1. 规范内容来源</h2>
          <p>
            本站中文文档内容翻译并整理自 Answer.AI 在 GitHub 发布的开源提案 <a href="https://github.com/AnswerDotAI/llms-txt/blob/main/nbs/index.qmd" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4">AnswerDotAI/llms-txt</a>（v2 修订版），旨在为中文开发者与内容团队提供清晰的参考资料。
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-xl font-semibold text-foreground">2. 代码示例与工具使用</h2>
          <p>
            本站提供的在线解析器、JavaScript 代码片段与模板生成器均按原样提供，供开发者自由学习、测试与集成到您的网站工程中。生产上线前请结合自身业务场景与安全策略进行充分验证。
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-xl font-semibold text-foreground">3. 规范演进</h2>
          <p>
            由于 <code class="font-mono text-sm text-foreground">/llms.txt</code> 规范仍在持续接收社区反馈并演进，若中英文表述存在细节差异，请以原仓库最新提交为准。
          </p>
        </section>
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href={homeHref}
          class="inline-flex items-center rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-primary-hover"
        >
          返回首页
        </a>
        <a
          href={docsHref}
          class="inline-flex items-center rounded-lg border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent"
        >
          浏览规范文档
        </a>
      </div>
    </main>
    <LandingFooter />
  </div>
</BaseLayout>
