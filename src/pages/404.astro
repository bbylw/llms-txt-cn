---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;
const homeHref = withBase("/", import.meta.env.BASE_URL);
const docsHref = withBase("/docs/", import.meta.env.BASE_URL);
const llmsHref = withBase("/llms.txt", import.meta.env.BASE_URL);
---

<BaseLayout title="页面未找到" description="您访问的页面不存在或已移动。" noindex>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-2xl w-full px-6 py-24 text-center">
      <p class="font-mono text-sm font-medium text-muted-foreground">404</p>
      <h1
        class="mt-2 text-foreground leading-tight text-balance"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        页面未找到
      </h1>
      <p class="mt-3 text-base text-muted-foreground leading-relaxed text-pretty">
        您请求的页面路径不存在或已经迁移。您可以返回首页、进入规范文档，或直接检索全站索引。
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={homeHref}
          class="inline-flex items-center rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-primary-hover"
        >
          返回首页
        </a>
        <a
          href={docsHref}
          class="inline-flex items-center rounded-lg border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent"
        >
          阅读规范文档
        </a>
        <a
          href={llmsHref}
          class="inline-flex items-center rounded-lg border border-border bg-card px-3 py-2 font-mono text-sm font-medium text-muted-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground"
        >
          /llms.txt
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
