<style>
  /* Hero heading text gradient — light and dark */
  .hero-title-gradient {
    background-image: linear-gradient(90deg, #000000 0%, #666666 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global([data-mode="dark"]) .hero-title-gradient {
    background-image: linear-gradient(90deg, #ffffff 0%, #9b9b9b 100%);
  }
</style>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";

  // Hero code copy button
  mount("[data-hero-copy]", (btn) => {
    const label = btn.querySelector<HTMLElement>("[data-hero-copy-label]");
    const code = document.querySelector<HTMLElement>("[data-hero-code]");
    if (!label || !code) return () => {};

    let timer: number | undefined;
    const onClick = async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "已复制";
      } catch {
        label.textContent = "复制受限";
      }
      if (timer) window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = "复制示例";
      }, 1500);
    };
    btn.addEventListener("click", onClick);
    return () => {
      btn.removeEventListener("click", onClick);
      if (timer) window.clearTimeout(timer);
    };
  });

  // Single IntersectionObserver for one-time section reveals
  mount("#main-content", (main) => {
    const targets = Array.from(main.querySelectorAll<HTMLElement>(".nb-reveal"));
    if (targets.length === 0) return () => {};

    const reveal = (el: Element) => {
      el.removeAttribute("data-reveal-state");
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight) {
            reveal(entry.target);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.01 },
    );

    const syncVisible = () => {
      for (const el of targets) {
        if (!el.hasAttribute("data-reveal-state")) continue;
        const rect = el.getBoundingClientRect();
        if (rect.top <= window.innerHeight * 0.96) {
          reveal(el);
          observer.unobserve(el);
        }
      }
    };

    targets.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top <= window.innerHeight * 0.96) {
        reveal(el);
      } else {
        el.setAttribute("data-reveal-state", "pending");
        observer.observe(el);
      }
    });

    const onHash = () => window.requestAnimationFrame(syncVisible);
    window.addEventListener("hashchange", onHash);

    return () => {
      observer.disconnect();
      window.removeEventListener("hashchange", onHash);
    };
  });
</script>
