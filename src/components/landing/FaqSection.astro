---
export interface FaqItem {
  question: string;
  answer: string;
}

export const faqs: FaqItem[] = [
  {
    question: "/llms.txt 与 robots.txt 有什么区别，需要同时保留吗？",
    answer:
      "两者职责完全不同，应当共存。robots.txt 用于告知网络爬虫哪些路径允许或禁止抓取；llms.txt 则是面向按需推理阶段的专家级导航索引，在智能体协助用户查询资料时，为其提供精炼背景与最相关的 Markdown 链接。",
  },
  {
    question: "为什么不能直接用 sitemap.xml 代替 /llms.txt？",
    answer:
      "sitemap.xml 面向搜索引擎列出全站所有 HTML 页面，通常不包含干净的 Markdown 版本链接，也不能指向外部依赖文档；此外，全量站点地图汇总后的体积往往远超模型的上下文窗口，且夹杂大量非核心页面。",
  },
  {
    question: "为什么规范选择路径下的 /llms.txt，而不是 /.well-known/？",
    answer:
      "RFC 8615 规定的 /.well-known/ 只能部署在源站根目录。大量创作者仅对共享主机上的子路径拥有发布权限（例如 GitHub Pages 项目站点）。将 llms.txt 放在任意子路径下，可以准确描述该子目录覆盖的文档范围。",
  },
  {
    question: "页面 Markdown 版本应该命名为 page.html.md 还是 page.md？",
    answer:
      "v2 规范同时允许这两种形式。既可以在原 URL 末尾直接追加 .md（如 page.html.md），也可以将原有扩展名替换为 .md（如 page.md）；没有文件名的目录 URL 则追加 index.html.md 或 index.md。",
  },
  {
    question: "客户端如何无需猜测就能发现页面的 Markdown 版本和 llms.txt？",
    answer:
      "v2 规范推荐使用两个标准链接关系：rel=\"alternate\" type=\"text/markdown\" 指向当前页面的 Markdown 版本，rel=\"describedby\" 指向覆盖该页面的 llms.txt 文件。既可写入 HTML <link> 标签，也可通过 HTTP Link: 响应头下发。",
  },
  {
    question: "如果网站根路径和 /docs/ 子路径都放了 llms.txt，以哪个为准？",
    answer:
      "根据 v2 规范的定义，每个 llms.txt 文件描述其所在路径及之下的所有 URL。当多个文件同时适用某个页面时，智能体应选择路径最具体的那一份（例如 /docs/page.html 优先遵循 /docs/llms.txt）。",
  },
  {
    question: "v2 规范中 ## Optional 分组还有什么作用？",
    answer:
      "v2 移除了早期 llms_txt2ctx 上下文批量展开工具及其机械剔除逻辑，因此 Optional 不再具有强制语义；但它依然是广泛采用的实用惯例，用来标注当智能体需要更精简上下文时可以安全跳过的次要链接。",
  },
  {
    question: "如何在不修改现有网页源码的情况下快速落地 v2 规范？",
    answer:
      "可以在 Web 服务器或 CDN 层直接配置 HTTP Link: 响应头，为页面返回 alternate Markdown 链接与 describedby 索引链接；同时配合如 Mintlify、GitBook 或 Cloudflare Nimbus 等支持自动生成 .md 与 llms.txt 的工具链实现零侵入接入。",
  },
];
---

<section
  id="faq"
  class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20"
  aria-labelledby="faq-heading"
>
  <div class="mb-10 max-w-[680px]">
    <p class="font-mono text-xs font-medium tracking-wider text-muted-foreground">FAQ · 常见问题</p>
    <h2 id="faq-heading" class="mt-2 text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
      关于 /llms.txt v2 的关键解答
    </h2>
  </div>

  <dl class="grid grid-cols-1 gap-x-10 gap-y-8 border-t border-border pt-8 md:grid-cols-2">
    {faqs.map((item) => (
      <div class="space-y-2">
        <dt class="text-base font-semibold leading-6 text-foreground [text-wrap:balance]">
          {item.question}
        </dt>
        <dd class="m-0 text-sm leading-6 text-muted-foreground [text-wrap:pretty]">
          {item.answer}
        </dd>
      </div>
    ))}
  </dl>
</section>
