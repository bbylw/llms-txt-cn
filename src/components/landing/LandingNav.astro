---
import Logo from "@/components/Logo.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { ThemeToggle } from "@/components/ui/theme-toggle";
import { config } from "virtual:nimbus/config";
import { stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

const currentSlug =
  stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const homeHref = withBase("/", import.meta.env.BASE_URL);
const docsHref = withBase("/docs/", import.meta.env.BASE_URL);
const isHome = currentSlug === "/";

const links = [
  { label: "核心收益", href: isHome ? "#benefits" : `${homeHref}#benefits`, active: false },
  { label: "三步接入", href: isHome ? "#how-it-works" : `${homeHref}#how-it-works`, active: false },
  { label: "演练场", href: isHome ? "#playground" : `${homeHref}#playground`, active: false },
  { label: "生态采纳", href: isHome ? "#ecosystem" : `${homeHref}#ecosystem`, active: false },
  { label: "文档", href: docsHref, active: currentSlug.startsWith("/docs") },
];
---

<header class="sticky top-4 z-40 mx-auto w-full px-4 pointer-events-none">
  <div class="pointer-events-auto mx-auto flex w-fit max-w-full items-center gap-2 rounded-2xl border border-border bg-card/80 px-3 py-2 shadow-sm backdrop-blur-md">
    <a
      href={homeHref}
      aria-label={config.title}
      class="flex shrink-0 items-center gap-2 rounded-lg px-2 py-1 text-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent"
    >
      <Logo class="h-4 w-6 shrink-0" />
      <span class="font-mono text-sm font-semibold tracking-tight">llms.txt</span>
    </a>

    <nav aria-label="主导航" class="hidden md:flex items-center gap-1 border-s border-border ps-2">
      {links.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-1 text-sm font-medium no-underline whitespace-nowrap transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]",
            item.active
              ? "bg-accent text-foreground"
              : "text-muted-foreground hover:bg-accent/60 hover:text-foreground",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1 border-s border-border ps-2">
      {config.github && (
        <a
          href={config.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub 仓库"
          class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent hover:text-foreground"
        >
          <Icon name="ph:github-logo" class="h-4 w-4" />
        </a>
      )}

      <ThemeToggle />

      <button
        type="button"
        data-landing-menu-open
        command="show-modal"
        commandfor="landing-mobile-menu"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="landing-mobile-menu"
        class="md:hidden relative flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-foreground transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent active:scale-[0.98]"
      >
        <span data-line-top class="absolute h-0.5 w-4 rounded-full bg-current transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] -translate-y-1"></span>
        <span data-line-bottom class="absolute h-0.5 w-4 rounded-full bg-current transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] translate-y-1"></span>
      </button>
    </div>
  </div>
</header>

<dialog
  id="landing-mobile-menu"
  data-landing-menu-dialog
  closedby="any"
  aria-label="移动端站点导航"
  class="nb-dialog fixed inset-0 z-50 m-0 h-dvh w-screen max-h-none max-w-none border-0 bg-background/95 p-6 text-foreground backdrop-blur-xl"
>
  <div class="mx-auto flex h-full max-w-md flex-col justify-between">
    <div>
      <div class="flex items-center justify-between border-b border-border pb-4">
        <a href={homeHref} class="flex items-center gap-2 text-foreground no-underline">
          <Logo class="h-5 w-7" />
          <span class="font-mono text-base font-semibold">llms.txt</span>
        </a>
        <button
          type="button"
          data-landing-menu-close
          command="close"
          commandfor="landing-mobile-menu"
          autofocus
          aria-label="关闭导航菜单"
          class="relative flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-border bg-card text-foreground transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent active:scale-[0.98]"
        >
          <span class="absolute h-0.5 w-4 rotate-45 rounded-full bg-current"></span>
          <span class="absolute h-0.5 w-4 -rotate-45 rounded-full bg-current"></span>
        </button>
      </div>

      <nav aria-label="移动端菜单链接" class="mt-8 flex flex-col gap-3">
        {links.map((item, idx) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            data-landing-menu-item
            style={`--menu-delay: ${Math.min(idx * 60, 360)}ms`}
            class:list={[
              "landing-menu-link rounded-xl border px-4 py-3 text-lg font-semibold no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]",
              item.active
                ? "border-border-strong bg-accent text-foreground"
                : "border-border bg-card text-muted-foreground hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))}
        {config.github && (
          <a
            href={config.github}
            target="_blank"
            rel="noopener noreferrer"
            data-landing-menu-item
            style={`--menu-delay: ${Math.min(links.length * 60, 360)}ms`}
            class="landing-menu-link flex items-center justify-between rounded-xl border border-border bg-card px-4 py-3 text-base font-medium text-muted-foreground no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground"
          >
            <span>GitHub</span>
            <Icon name="ph:github-logo" class="h-5 w-5" />
          </a>
        )}
      </nav>
    </div>

    <div class="border-t border-border pt-4 text-xs text-muted-foreground">
      基于 Answer.AI /llms.txt v2 规范（2026 年 8 月修订）构建
    </div>
  </div>
</dialog>

<style>
  dialog[data-landing-menu-dialog]:not([open]) {
    display: none;
  }

  [data-landing-menu-open][aria-expanded="true"] [data-line-top] {
    transform: translateY(0) rotate(45deg);
  }
  [data-landing-menu-open][aria-expanded="true"] [data-line-bottom] {
    transform: translateY(0) rotate(-45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog[data-landing-menu-dialog][open] .landing-menu-link {
      animation: landing-menu-enter 400ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: var(--menu-delay, 0ms);
    }
    @keyframes landing-menu-enter {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";
  import { closeAnimatedDialog } from "@/components/ui/dialog/dialog.client";

  mount("[data-landing-menu-open]", (openBtn) => {
    const dialog = document.querySelector<HTMLDialogElement>("[data-landing-menu-dialog]");
    const closeBtn = dialog?.querySelector<HTMLButtonElement>("[data-landing-menu-close]");
    if (!dialog || !closeBtn) return () => {};

    const controller = new AbortController();
    const { signal } = controller;

    // Native Invoker Commands (`commandfor`/`command`) handle opening and closing
    // declaratively; bind listeners only when progressive fallback is needed.
    if (!("commandForElement" in HTMLButtonElement.prototype)) {
      openBtn.addEventListener(
        "click",
        () => {
          if (!dialog.open) dialog.showModal();
          openBtn.setAttribute("aria-expanded", "true");
        },
        { signal },
      );
      closeBtn.addEventListener("click", () => void closeAnimatedDialog(dialog), { signal });
    }

    if (!("closedBy" in HTMLDialogElement.prototype)) {
      let pressedOn: EventTarget | null = null;
      dialog.addEventListener("pointerdown", (e) => { pressedOn = e.target; }, { signal });
      dialog.addEventListener(
        "pointerup",
        (e) => {
          if (e.target === dialog && pressedOn === dialog) void closeAnimatedDialog(dialog);
          pressedOn = null;
        },
        { signal },
      );
    }

    dialog.addEventListener(
      "toggle",
      () => {
        openBtn.setAttribute("aria-expanded", String(dialog.open));
      },
      { signal },
    );

    dialog.addEventListener(
      "close",
      () => {
        openBtn.setAttribute("aria-expanded", "false");
        openBtn.focus();
      },
      { signal },
    );

    dialog.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => void closeAnimatedDialog(dialog), { signal });
    });

    return () => controller.abort();
  });
</script>
