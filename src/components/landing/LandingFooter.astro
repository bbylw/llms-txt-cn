---
import Logo from "@/components/Logo.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

const homeHref = withBase("/", import.meta.env.BASE_URL);
---

<footer class="border-t border-border bg-background">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-center">
      <a href={homeHref} class="inline-flex w-fit items-center gap-2 text-foreground no-underline transition-opacity duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:opacity-75">
        <Logo class="h-5 w-7" />
        <span class="font-mono text-base font-semibold tracking-tight">llms.txt</span>
      </a>

      <nav aria-label="页脚导航" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
        <a href={withBase("/docs/", import.meta.env.BASE_URL)} class="no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground">文档</a>
        <a href={withBase("/llms.txt", import.meta.env.BASE_URL)} class="font-mono no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground">/llms.txt</a>
        <a href={withBase("/llms-full.txt", import.meta.env.BASE_URL)} class="font-mono no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground">/llms-full.txt</a>
        <a href="https://github.com/AnswerDotAI/llms-txt" target="_blank" rel="noopener noreferrer" class="no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground">GitHub</a>
        <a href="https://llmstxt.site/" target="_blank" rel="noopener noreferrer" class="no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground">官方目录</a>
        <a href="https://discord.gg/aJPygMvPEN" target="_blank" rel="noopener noreferrer" class="no-underline transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-foreground">Discord</a>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>规范原作者：Jeremy Howard（Answer.AI）</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href={withBase("/privacy/", import.meta.env.BASE_URL)} class="no-underline transition-colors hover:text-foreground">隐私政策</a>
        <a href={withBase("/terms/", import.meta.env.BASE_URL)} class="no-underline transition-colors hover:text-foreground">使用条款</a>
        <span class="font-mono">/llms.txt v2</span>
      </div>
    </div>
  </div>
</footer>
