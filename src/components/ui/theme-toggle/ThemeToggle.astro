---
/**
 * ThemeToggle — light/dark switcher synchronized with `<meta name="color-scheme">`
 * and `<html data-mode="dark">` via BaseLayout's pre-paint script.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

const { class: className, ...attrs } = Astro.props;
---

<button
  data-slot="theme-toggle"
  type="button"
  data-nb-theme-toggle
  class={cn(
    "group flex items-center justify-center w-8 h-8 rounded-lg border border-transparent text-muted-foreground hover:text-foreground hover:bg-accent active:scale-[0.98] transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] cursor-pointer",
    className,
  )}
  {...attrs}
  aria-label="切换浅色与深色主题"
  aria-pressed="false"
>
  <Icon name="ph:sun" class="w-4 h-4 hidden dark:block" aria-hidden="true" />
  <Icon name="ph:moon" class="w-4 h-4 dark:hidden" aria-hidden="true" />
  <span class="sr-only dark:hidden">切换至深色模式</span>
  <span class="sr-only hidden dark:inline">切换至浅色模式</span>
</button>

<script>
  import "./theme-toggle.client";
</script>
